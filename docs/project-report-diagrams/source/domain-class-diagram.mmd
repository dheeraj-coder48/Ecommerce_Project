classDiagram
  direction LR
  class Customer["Sanity customer document"] {
    _id
    email
    name
    clerkUserId
    stripeCustomerId
  }
  class Order["Sanity order document"] {
    _id
    orderNumber
    total INR
    status
    paymentStatus
    fulfillmentStatus
    stripePaymentId
    customerPhone
    createdAt
  }
  class OrderItem["Embedded order item"] { quantity priceAtPurchase color size }
  class Address["Embedded address"] { name line1 line2 city postcode country }
  class Wishlist["Sanity wishlist document"] { _id clerkUserId updatedAt }
  class StatusEmail["Sanity status-notification document"] { fromStatus toStatus deliveryStatus attemptCount }
  class Cart["Browser-persisted Zustand state"] { productId quantity color size price }
  class Product["Sanity product document"] { _id name slug }
  Order "1" *-- "0..*" OrderItem : embedded items
  OrderItem "0..*" --> "1" Product : product reference
  Order "0..*" --> "0..1" Customer : optional customer reference
  Order "1" *-- "0..1" Address : embedded address
  StatusEmail "0..*" --> "1" Order : order reference
  Wishlist "0..*" --> "0..*" Product : product references
  Cart ..> Product : local product ID snapshot
